@model SistemaGFYMP.Modelos.MantenimientoProgramado

@{
    ViewData["Title"] = "Crear Mantenimiento Programado";
}

<div class="container mt-5">
    <h1 class="text-center text-primary">Crear Mantenimiento Programado</h1>
    <h4 class="text-center text-secondary">Formulario para crear un nuevo mantenimiento programado</h4>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 bg-light p-4 rounded shadow-sm">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Fecha" class="form-label">Fecha</label>
                    <input asp-for="Fecha" class="form-control" type="date" />
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="TipoMantenimiento" class="form-label">Tipo de Mantenimiento</label>
                    <input asp-for="TipoMantenimiento" class="form-control" placeholder="Ingrese el tipo de mantenimiento" />
                    <span asp-validation-for="TipoMantenimiento" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="TallerCodigo" class="form-label">Taller</label>
                    <select asp-for="TallerCodigo" class="form-control" asp-items="ViewBag.Talleres">
                        <option value="">--Seleccione Taller--</option>
                    </select>
                    <span asp-validation-for="TallerCodigo" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="CamionCodigo" class="form-label">Camión</label>
                    <select asp-for="CamionCodigo" class="form-control" asp-items="ViewBag.Camiones">
                        <option value="">--Seleccione Camión--</option>
                    </select>
                    <span asp-validation-for="CamionCodigo" class="text-danger"></span>
                </div>

                <div class="form-group text-center mb-3">
                    <input type="submit" value="Crear" class="btn btn-success w-100" />
                </div>
            </form>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
