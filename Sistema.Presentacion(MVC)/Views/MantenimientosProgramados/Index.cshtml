@model IEnumerable<SistemaGFYMP.Modelos.MantenimientoProgramado>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Codigo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Fecha)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipoMantenimiento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TallerCodigo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CamionCodigo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Codigo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Fecha)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TipoMantenimiento)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TallerCodigo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CamionCodigo)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id=item.Codigo}) |
                @Html.ActionLink("Details", "Details", new { id=item.Codigo }) |
                @Html.ActionLink("Delete", "Delete", new { id=item.Codigo  })
            </td>
        </tr>
}
    </tbody>
</table>
