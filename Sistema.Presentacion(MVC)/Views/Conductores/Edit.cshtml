@model SistemaGFYMP.Modelos.Conductor

@{
    ViewData["Title"] = "Editar Conductor";
}

<div class="container mt-5">
    <h1 class="text-center text-primary">Editar Conductor</h1>
    <h4 class="text-center text-secondary">Actualiza la información del conductor</h4>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 bg-light p-4 rounded shadow-sm">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Codigo" class="form-label">Código</label>
                    <input asp-for="Codigo" class="form-control" readonly="readonly" />
                    <span asp-validation-for="Codigo" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre del conductor" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Licencia" class="form-label">Número de Licencia</label>
                    <input asp-for="Licencia" class="form-control" placeholder="Ingrese el número de licencia" />
                    <span asp-validation-for="Licencia" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="FechaVencimientoLicencia" class="form-label">Fecha de Vencimiento de Licencia</label>
                    <input asp-for="FechaVencimientoLicencia" class="form-control" placeholder="Ingrese la fecha de vencimiento" />
                    <span asp-validation-for="FechaVencimientoLicencia" class="text-danger"></span>
                </div>

                <div class="form-group text-center mb-3">
                    <input type="submit" value="Guardar" class="btn btn-success w-100" />
                </div>
            </form>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
