@model IEnumerable<SistemaGFYMP.Modelos.Camion>

@{
    ViewData["Title"] = "Gestion De Camiones";
}

<!-- Contenedor principal -->
<div class="container mt-5">
    <h1 class="text-center">@ViewData["Title"]</h1>

    <!-- Botón para crear nuevo camión -->
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">Crear Nuevo Camión</a>
    </div>

    <!-- Tabla con Bootstrap -->
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Codigo)</th>
                <th>@Html.DisplayNameFor(model => model.Marca)</th>
                <th>@Html.DisplayNameFor(model => model.Modelo)</th>
                <th>@Html.DisplayNameFor(model => model.Año)</th>
                <th>@Html.DisplayNameFor(model => model.Placa)</th>
                <th>@Html.DisplayNameFor(model => model.Kilometraje)</th>
                <th>@Html.DisplayNameFor(model => model.Estado)</th>
                <th>@Html.DisplayNameFor(model => model.NivelGasolina)</th>
                <th>@Html.DisplayNameFor(model => model.NivelAceite)</th>
                <th>@Html.DisplayNameFor(model => model.EstadoMotor)</th>
                <th>Nombre del Conductor</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Codigo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Marca)</td>
                    <td>@Html.DisplayFor(modelItem => item.Modelo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Año)</td>
                    <td>@Html.DisplayFor(modelItem => item.Placa)</td>
                    <td>@Html.DisplayFor(modelItem => item.Kilometraje)</td>
                    <td>@Html.DisplayFor(modelItem => item.Estado)</td>
                    <td>@Html.DisplayFor(modelItem => item.NivelGasolina)</td>
                    <td>@Html.DisplayFor(modelItem => item.NivelAceite)</td>
                    <td>@Html.DisplayFor(modelItem => item.EstadoMotor)</td>
                    <td>@Html.DisplayFor(modelItem => item.Conductor.Nombre)</td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id = item.Codigo }) |
                        @Html.ActionLink("Details", "Details", new { id = item.Codigo }) |
                        @Html.ActionLink("Delete", "Delete", new { id = item.Codigo })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
