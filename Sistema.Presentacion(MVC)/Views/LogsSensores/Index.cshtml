@model List<SistemaLogs.Modelos.LogSensor>

<h2>Logs de Sensores</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Código</th>
            <th>Camión Código</th>
            <th>Kilometraje</th>
            <th>Estado del Motor</th>
            <th>Fecha Lectura</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.Codigo</td>
                <td>@log.CamionCodigo</td>
                <td>@log.Kilometraje</td>
                <td>@log.EstadoMotor</td>
                <td>@log.FechaLectura.ToString("g")</td>
            </tr>
        }
    </tbody>
</table>
