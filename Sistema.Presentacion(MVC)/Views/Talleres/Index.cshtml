@model IEnumerable<SistemaGFYMP.Modelos.Taller>

@{
    ViewData["Title"] = "Talleres";
}

<div class="container mt-5">
    <h1 class="text-center text-primary">Talleres</h1>
    <h4 class="text-center text-secondary">Lista de todos los talleres registrados</h4>
    <hr />

    <div class="text-center mb-3">
        <a asp-action="Create" class="btn btn-success">Crear Nuevo Taller</a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="thead-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Codigo)</th>
                    <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                    <th>@Html.DisplayNameFor(model => model.Ciudad)</th>
                    <th>Reparaciones Máximas</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Codigo)</td>
                        <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                        <td>@Html.DisplayFor(modelItem => item.Ciudad)</td>
                        <td>@Html.DisplayFor(modelItem => item.CapacidadMaximaReparaciones)</td>
                        <td>
                            @Html.ActionLink("Edit", "Edit", new { id = item.Codigo }) |
                            @Html.ActionLink("Details", "Details", new { id = item.Codigo }) |
                            @Html.ActionLink("Delete", "Delete", new { id = item.Codigo })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
