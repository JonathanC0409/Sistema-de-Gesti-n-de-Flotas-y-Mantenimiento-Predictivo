@model SistemaGFYMP.Modelos.Taller

@{
    ViewData["Title"] = "Eliminar Taller";
}

<div class="container mt-5">
    <h1 class="text-center text-danger">¿Estás seguro de que deseas eliminar este taller?</h1>
    <h4 class="text-center text-secondary">Confirmación de eliminación</h4>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 bg-light p-4 rounded shadow-sm">
            <h4 class="text-center text-primary">Detalles del Taller</h4>
            <dl class="row">
                <dt class="col-sm-4">Código</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Codigo)</dd>

                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombre)</dd>

                <dt class="col-sm-4">Ciudad</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Ciudad)</dd>

                <dt class="col-sm-4">Reparaciones Máximas</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.CapacidadMaximaReparaciones)</dd>
            </dl>

            <div class="text-center mt-3">
                <form asp-action="Delete">
                    <input type="submit" value="Eliminar" class="btn btn-danger w-50" />
                </form>
                <div class="mt-3">
                    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
