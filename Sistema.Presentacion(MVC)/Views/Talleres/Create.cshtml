@model SistemaGFYMP.Modelos.Taller

@{
    ViewData["Title"] = "Crear Taller";
}

<div class="container mt-5">
    <h1 class="text-center text-primary">Crear Nuevo Taller</h1>
    <h4 class="text-center text-secondary">Formulario para agregar un nuevo taller</h4>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 bg-light p-4 rounded shadow-sm">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre del Taller</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre del taller" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Ciudad" class="form-label">Ciudad</label>
                    <input asp-for="Ciudad" class="form-control" placeholder="Ingrese la ciudad del taller" />
                    <span asp-validation-for="Ciudad" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="CapacidadMaximaReparaciones" class="form-label">Reparaciones Máximas</label>
                    <input asp-for="CapacidadMaximaReparaciones" class="form-control" placeholder="Ingrese la capacidad máxima de reparaciones" />
                    <span asp-validation-for="CapacidadMaximaReparaciones" class="text-danger"></span>
                </div>

                <div class="form-group text-center mb-3">
                    <input type="submit" value="Crear" class="btn btn-success w-100" />
                </div>
            </form>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
